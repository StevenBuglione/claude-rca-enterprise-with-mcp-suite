# --- Bedrock / Claude Code runtime ---
CLAUDE_CODE_USE_BEDROCK=1
AWS_REGION=us-east-1

# Example Bedrock Opus 4.5 modelId (confirm in your account/region):
ANTHROPIC_MODEL=global.anthropic.claude-opus-4-5-20251101-v1:0

# Claude Code output / thinking budgets
CLAUDE_CODE_MAX_OUTPUT_TOKENS=4096
MAX_THINKING_TOKENS=1024

# --- AWS auth (choose one) ---
# Option A: AWS_PROFILE (mount ~/.aws in compose)
AWS_PROFILE=default

# Option B: static keys (local dev only)
# AWS_ACCESS_KEY_ID=...
# AWS_SECRET_ACCESS_KEY=...
# AWS_SESSION_TOKEN=...

# Option C: Bedrock API key (if your org uses it)
# AWS_BEARER_TOKEN_BEDROCK=...

# --- Service ---
PORT=8000
MAX_CONCURRENT_RCA=2

# Evidence store (Postgres)
EVIDENCE_STORE_URL=postgresql://rca:rca@postgres:5432/rca

# Postgres (local)
POSTGRES_DB=rca
POSTGRES_USER=rca
POSTGRES_PASSWORD=rca

# --- Observability ---
LOG_LEVEL=INFO
OTEL_SERVICE_NAME=claude-rca-api
# When using docker compose --profile obs:
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4317
OTEL_EXPORTER_OTLP_PROTOCOL=grpc
OTEL_TRACES_EXPORTER=otlp
OTEL_METRICS_EXPORTER=otlp
OTEL_LOGS_EXPORTER=none

# ---------------- MCP Suite (local) ----------------
# Shared auth token the RCA API uses to call MCP services:
MCP_AUTH_TOKEN=change-me

# Jenkins MCP → Jenkins upstream
JENKINS_BASE_URL=https://jenkins.example.com
JENKINS_USER=svc-jenkins
JENKINS_API_TOKEN=xxxx
JENKINS_VERIFY_SSL=true

# Bitbucket MCP → Bitbucket Data Center upstream
BITBUCKET_BASE_URL=https://bitbucket.example.com
BITBUCKET_API_PREFIX=/rest/api/1.0
BITBUCKET_AUTH_MODE=bearer
BITBUCKET_USER=svc-bitbucket
BITBUCKET_TOKEN=xxxx
BITBUCKET_VERIFY_SSL=true

# Confluence MCP → Confluence Data Center upstream
CONFLUENCE_BASE_URL=https://confluence.example.com
CONFLUENCE_API_PREFIX=/rest/api
CONFLUENCE_AUTH_MODE=bearer
CONFLUENCE_USER=svc-confluence
CONFLUENCE_TOKEN=xxxx
CONFLUENCE_VERIFY_SSL=true

# Sourcebot MCP (mock by default)
SOURCEBOT_MODE=mock
# SOURCEBOT_MOCK_DATA=/app/app/mock_data.json

# When using a real Sourcebot API:
# SOURCEBOT_HOST=https://sourcebot.example.com
# SOURCEBOT_API_KEY=xxxx
# SOURCEBOT_VERIFY_SSL=true
